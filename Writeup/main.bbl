    \verb 10.1007/S10236-018-1214-0/FIGURES/30
    \endverb
    \field{issn}{16167228}
    \field{issue}{11}
    \field{pages}{1571\bibrangedash 1592}
    \field{title}{Korean East Coast wave predictions by means of ensemble
  Kalman filter data assimilation}
    \verb{url}
    \verb https://link.springer.com/article/10.1007/s10236-018-1214-0
    \endverb
    \field{volume}{68}
    \field{journaltitle}{Ocean Dynamics}
